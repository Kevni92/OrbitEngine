{
  "name": "orbit-engine",
  "version": "0.1.0",
  "description": "Portable OrbitEngine TypeScript facade with native and WebAssembly backends.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "prebuilds/**/*.node",
    "wasm/*.js",
    "wasm/*.wasm",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "node ../../scripts/run-tests.mjs unit",
    "test:native": "node ../../scripts/run-tests.mjs native",
    "test:wasm": "node ../../scripts/run-tests.mjs wasm",
    "test:parity": "node ../../scripts/run-tests.mjs parity"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.3"
  }
}
