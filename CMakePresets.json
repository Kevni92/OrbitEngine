{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-debug",
      "displayName": "Portable core (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ORBIT_ENGINE_BUILD_TESTS": "ON",
        "ORBIT_ENGINE_BUILD_NODE": "OFF",
        "ORBIT_ENGINE_BUILD_WASM": "OFF"
      }
    },
    {
      "name": "core-release",
      "displayName": "Portable core (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ORBIT_ENGINE_BUILD_TESTS": "ON",
        "ORBIT_ENGINE_BUILD_NODE": "OFF",
        "ORBIT_ENGINE_BUILD_WASM": "OFF"
      }
    }
  ]
}
