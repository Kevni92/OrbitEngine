{
  "name": "orbit-engine-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:three && pnpm run build:core && pnpm run build:native && pnpm run build:wasm",
    "build:ts": "pnpm --filter orbit-engine build",
    "build:three": "pnpm --filter orbit-engine-three build",
    "build:core": "node scripts/build-core.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:cpp": "node scripts/test-core.mjs",
    "test:ts": "pnpm --filter orbit-engine test:unit",
    "test:three": "pnpm --filter orbit-engine-three test",
    "test:native": "pnpm --filter orbit-engine test:native",
    "test:wasm": "pnpm --filter orbit-engine test:wasm",
    "test:parity": "pnpm --filter orbit-engine test:parity",
    "test:oep-importer": "node --test tools/oep-importer/tests/importer.test.mjs",
    "test:oep-production": "node --test tools/oep-importer/tests/production-pack.test.mjs",
    "test:oep-importer:spice": "node --test tools/oep-importer/tests/spice-integration.test.mjs",
    "test:oep-importer:runtime:native": "node tools/oep-importer/tests/runtime-compat.mjs native",
    "test:oep-importer:runtime:wasm": "node tools/oep-importer/tests/runtime-compat.mjs wasm",
    "package:smoke": "node scripts/package-smoke.mjs",
    "package:three-smoke": "node scripts/three-package-smoke.mjs",
    "three:browser:packaged": "node scripts/three-packaged-browser-smoke.mjs",
    "browser:build": "pnpm --filter orbit-engine build && pnpm --filter orbit-engine-browser-smoke typecheck && pnpm --filter orbit-engine-browser-smoke build",
    "browser:smoke": "pnpm --filter orbit-engine-browser-smoke smoke",
    "demo": "pnpm --filter orbit-engine-solar-system-demo dev",
    "demo:build": "pnpm --filter orbit-engine build && pnpm run build:three && pnpm --filter orbit-engine-solar-system-demo typecheck && pnpm --filter orbit-engine-solar-system-demo build",
    "demo:test": "pnpm --filter orbit-engine-solar-system-demo test:unit",
    "demo:smoke": "pnpm --filter orbit-engine-solar-system-demo smoke",
    "test": "pnpm run test:cpp && pnpm run test:ts && pnpm run test:three && pnpm run test:oep-importer",
    "check": "pnpm run build:ts && pnpm run build:three && pnpm run test:cpp && pnpm run test:ts && pnpm run test:three && pnpm run test:oep-importer"
  },
  "devDependencies": {
    "node-addon-api": "8.9.2",
    "node-api-headers": "1.9.0"
  }
}
